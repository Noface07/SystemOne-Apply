# Decision model: which backend makes the choices. Common fields (CTC, notice period, experience, contact
# details, education, skills...) are answered by fixed rules first, whatever you pick here.
#   laya      (default) Laya, open weights, runs on this machine (`uv sync --extra playwright --extra laya`).
#             A fixed procedure walks the form; Laya only picks answers the rules can't. No API, no limits.
#   llm       a chat model through any OpenAI-compatible API (OpenRouter, or Ollama on this PC) decides
#             everything the rules don't, including how to move through the page. Uses DECISION_* below.
#   clef      Cloudflare's Clef-Flash (9B, open weights) on this machine through llama-server (b11430 or newer).
#             Same fixed procedure; Clef only picks answers. Uses CLEF_* below. Needs about 7 GB of GPU memory.
#   typesafe  Jev through the TypeSafe API. Needs TYPESAFE_API_KEY below.
DECISION_BACKEND=laya

# For DECISION_BACKEND=clef. With CLEF_MODEL_PATH and CLEF_SERVER_BIN set, jev-apply starts llama-server itself
# when nothing answers at CLEF_BASE_URL (log: runs/clef-server.log) and stops it when it's done.
# CLEF_MODEL_PATH=D:/AI-Projects/CloudFlare-CLEF/Cloudflare_clef-flash-Q4_K_M.gguf
# CLEF_SERVER_BIN=D:/Llamacpp-b11436/llama-server.exe
# CLEF_BASE_URL=http://127.0.0.1:8080
# CLEF_MAX_OPTIONS=12      options per question kept for Clef (the ASK_USER/SKIP/DRAFT exits always stay)
# CLEF_GPU_LAYERS=99       lower it if the GPU runs out of memory (the rest runs on the CPU, slower)
# CLEF_CONTEXT=2048        also the batch size (a decision is read in one pass); RAM use grows with it

# Who steers through the page. procedure (default for laya and typesafe): the fixed procedure in planner.py
# walks the form and the model above only picks answers, so every rule and guard works the same with Laya or
# Jev. model: the model also decides each step (the default for llm).
# DECISION_STEERING=procedure

# For DECISION_BACKEND=llm (empty = use the TEXT_MODEL_* values below).
# OpenRouter ":free" models: 20 requests a minute (the tool paces itself) and 50 a day, or 1,000 a day once you
# have bought $10 of credits. One application takes roughly 20-40 decisions.
DECISION_MODEL=
DECISION_API_KEY=
DECISION_BASE_URL=
DECISION_REASONING=none
# Other models OpenRouter falls back to when the main one is busy, comma-separated (optional).
DECISION_FALLBACK_MODELS=

# Laya settings (all optional).
#   LAYA_CHECKPOINT: empty = English (ModernBERT-large), or "multilingual", or "typed-decisions"
#   LAYA_DEVICE: empty = auto (CUDA, then Apple MPS, then CPU)
#   LAYA_MAX_LEN / LAYA_HEAD_MAX_LEN: token budgets for page state / answer options (shipped: 512/192)
#   LAYA_MAX_OPTIONS: how many profile facts a single field's question keeps when the list is too long
LAYA_MODEL=convaiinnovations/laya
LAYA_CHECKPOINT=
LAYA_DEVICE=
LAYA_MAX_LEN=2048
LAYA_HEAD_MAX_LEN=1024
LAYA_MAX_OPTIONS=20
# HF_TOKEN=            optional, only for higher Hugging Face download limits

# Jev (TypeSafe System One), only when DECISION_BACKEND=typesafe. Get a key at https://console.typesafe.ai/keys
# Any compatible gateway works:
#   TypeSafe:   https://api.typesafe.ai
#   OpenRouter: https://openrouter.ai/api        (model: typesafe/jev-latest)
# TYPESAFE_MODEL can pin a version (e.g. jev-1.13.0) instead of following jev-latest. Long fact lists are
# shortlisted to TypeSafe's 255 options per question automatically.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Only used to DRAFT open-ended answers ("Why do you want to join us?"). Shown to you first unless submit_drafts.
# Two ways to draft:
#   TEXT_MODEL_PROVIDER=claude-code  the Claude Code CLI (`claude -p`) on your own Claude login: no API key.
#                                    It runs with no tools, from an empty folder. TEXT_MODEL=sonnet (or opus...).
#   (empty)                          an OpenAI-compatible endpoint with the key below.
# Leave both empty to be asked instead of drafting.
TEXT_MODEL_PROVIDER=
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Browser (optional). The agent maximises your Chrome window so a modal's Submit button fits at normal size.
# JEV_VIEWPORT_HEIGHT: also lay its tabs out at least this tall (off by default: whatever doesn't fit your
# window is cut off from view). JEV_BACKGROUND_TABS=1 keeps those tabs behind yours (JavaScript-heavy
# portals like Workday may not finish drawing there).
# JEV_VIEWPORT_HEIGHT=1000  (off unless set)
# JEV_BACKGROUND_TABS=0
